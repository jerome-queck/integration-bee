{
  "schema": "integration-bee-turn-request/v1",
  "kinds": ["empty", "teach", "mark", "mock-start", "mock-finish", "aptitude", "confirm", "cover"],
  "required": ["kind"],
  "mark": {
    "required": ["kind", "problem_id", "source", "extract"],
    "source": ["photo", "typed"],
    "extract": ["final_answer"],
    "extract_optional": ["method_note", "gap"],
    "optional": ["image"]
  },
  "mock-start": {
    "pack": ["mock01", "pdf-round1"],
    "cold": "boolean"
  },
  "mock-finish": {
    "required": ["kind", "id", "score"]
  },
  "confirm": {
    "required": ["kind", "nodes"]
  },
  "cover": {
    "full": "boolean"
  }
}

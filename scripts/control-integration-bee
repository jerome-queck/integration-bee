#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "verify"))

import model  # noqa: E402
import problem_catalog  # noqa: E402
import turn_contract  # noqa: E402

TZ = ZoneInfo("Asia/Singapore")
COMMANDS = [
    {"path": "doctor", "summary": "Report whether this checkout can run."},
    {"path": "practice list", "summary": "List drills without answers."},
    {"path": "practice next", "summary": "Print one due drill or the next unit drill."},
    {"path": "practice check", "summary": "Compare one answer with SymPy and record the attempt."},
    {"path": "progress show", "summary": "Print ticks, attempts, due reviews, streak, and weak topics."},
    {"path": "progress tick", "summary": "Set a skill-tree node to learning, solid, or skipped."},
    {"path": "progress mistake", "summary": "Record a diagnosed miss."},
    {"path": "progress mock-start", "summary": "Open a timed mock when Round 1 nodes are solid, or with --cold."},
    {"path": "progress mock-finish", "summary": "Store a mock score."},
    {"path": "progress journal", "summary": "Store a technique note."},
    {"path": "progress streak", "summary": "Count today as a study day."},
    {"path": "drills list", "summary": "List drill ids. Includes the display answer."},
    {"path": "problems list", "summary": "List contest and Yang problems without answers."},
    {"path": "problems show", "summary": "Print one stored problem, including a cited answer when the extract has one."},
    {"path": "problems select", "summary": "Print one problem prompt. Omits the answer and any worked solution."},
    {"path": "turn schema", "summary": "Print the teach, mark, and mock turn schemas."},
    {"path": "turn show", "summary": "Print the session and the coach report."},
    {"path": "turn apply", "summary": "Apply one teach, mark, mock, aptitude, confirm, or cover turn and write the session."},
    {"path": "verify", "summary": "Run verify/run.sh."},
]
HELP = {row["path"]: row["summary"] for row in COMMANDS}


def now_iso() -> str:
    return datetime.now(TZ).replace(microsecond=0).isoformat()


def today():
    return datetime.now(TZ).date()


def data_dir(arg: str | None) -> Path:
    raw = arg or os.environ.get("IB_DATA_DIR") or str(ROOT / "trackers" / "live")
    return Path(raw)


def catalog() -> list[dict]:
    return json.loads((ROOT / "trackers" / "catalog.json").read_text())["nodes"]


def load_drills() -> list[dict]:
    rows = []
    for path in sorted((ROOT / "verify").glob("drills_unit*.json")):
        rows.extend(json.loads(path.read_text()))
    return rows


def empty(name: str) -> dict:
    blanks = {
        "attempts": {"schema": "integration-bee-attempts/v1", "items": []},
        "heatmap": {"schema": "integration-bee-heatmap/v1", "topics": {}},
        "mocks": {"schema": "integration-bee-mocks/v1", "sessions": []},
        "journal": {"schema": "integration-bee-journal/v1", "notes": []},
        "streaks": {"schema": "integration-bee-streaks/v1", "days": [], "current": 0, "best": 0},
        "skill-ticks": {"schema": "integration-bee-skill-ticks/v1", "ticks": {}},
        "session": turn_contract.empty_session(),
        "marks": {"schema": "integration-bee-marks/v1", "marks": {}},
        "stickies": {"schema": "integration-bee-stickies/v1", "cards": {}},
    }
    return blanks[name]


def read_json(directory: Path, name: str) -> dict:
    path = directory / f"{name}.json"
    if not path.exists():
        return empty(name)
    try:
        doc = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        die(f"{name}.json did not parse: {exc}", 2)
    if not isinstance(doc, dict):
        die(f"{name}.json must be an object", 2)
    return doc


def load_session(doc: dict) -> dict:
    """Fill absent aptitude and policy. Reject a bad bool or a bad row.

    Does not write. turn show on a missing file still writes nothing.
    """
    out = dict(doc)
    if "aptitude" not in out:
        out["aptitude"] = {"full_coverage": False, "offer": [], "declined": []}
    elif isinstance(out.get("aptitude"), dict):
        apt = dict(out["aptitude"])
        if isinstance(apt.get("offer"), list):
            apt["offer"] = list(apt["offer"])
        if "declined" not in apt:
            apt["declined"] = []
        elif isinstance(apt.get("declined"), list):
            apt["declined"] = list(apt["declined"])
        out["aptitude"] = apt
    if "policy" not in out:
        out["policy"] = {}
    elif isinstance(out.get("policy"), dict):
        copied = {}
        for key, row in out["policy"].items():
            copied[key] = dict(row) if isinstance(row, dict) else row
        out["policy"] = copied
    err = model.session_problem(out)
    if err:
        die(err, 2)
    return out


def write_json(directory: Path, name: str, doc: dict) -> None:
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{name}.json"
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(doc, indent=2) + "\n")
    tmp.replace(path)


def project(directory: Path, ticks: dict, attempts: dict, mocks: dict, session: dict | None = None) -> None:
    mistakes = []
    for item in attempts["items"]:
        if item.get("correct") is False and item.get("note"):
            mistakes.append(
                {
                    "ts": item["ts"],
                    "problem_id": item["problem_id"],
                    "tags": item.get("tags") or [],
                    "note": item["note"],
                }
            )
    if session is None:
        session = read_json(directory, "session")
    doc = {
        "schema": "integration-bee-progress/v1",
        "skill_ticks": ticks["ticks"],
        "mistakes": mistakes,
        "mocks": mocks["sessions"],
        "session": {
            "phase": session.get("phase"),
            "node": session.get("node"),
            "problem_id": session.get("problem_id"),
            "mock_id": session.get("mock_id"),
        },
    }
    default = (ROOT / "trackers" / "live").resolve()
    target = ROOT / "progress.local.json" if directory.resolve() == default else directory / "progress.local.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(doc, indent=2) + "\n")


def emit(payload, fmt: str) -> None:
    if fmt == "json":
        print(json.dumps(payload, indent=2))
    else:
        if isinstance(payload, str):
            print(payload)
        else:
            print(json.dumps(payload, indent=2))


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def take_limit(rows: list, limit: int) -> list:
    if limit < 0:
        die("limit must be >= 0", 2)
    if limit == 0:
        return rows
    return rows[:limit]


def fold_token(value, allowed: frozenset):
    if not isinstance(value, str):
        return value
    folded = value.strip().casefold()
    if folded in allowed:
        return folded
    return value


def write_table(count: int, header: list[str], records: list[dict]) -> None:
    if len(records) == count:
        print(f"count={count}")
    else:
        print(f"count={count} shown={len(records)}")
    print("\t".join(header))
    for row in records:
        cells = []
        for key in header:
            text = row.get(key)
            if text is None:
                cells.append("")
            else:
                cells.append(str(text).replace("\t", " ").replace("\n", " "))
        print("\t".join(cells))


def latest_by_id(items: list[dict]) -> dict[str, dict]:
    latest: dict[str, dict] = {}
    for item in items:
        pid = item.get("problem_id")
        if pid:
            latest[pid] = item
    return latest


def public_drill(row: dict) -> dict:
    return {
        "id": row["id"],
        "unit": row["unit"],
        "technique": row.get("technique"),
        "latex": row.get("latex"),
        "kind": row.get("kind"),
        "yang": row.get("yang") or [],
        "hint": row.get("hint") or "",
    }


def find_drill(drill_id: str) -> dict | None:
    for row in load_drills():
        if row["id"] == drill_id:
            return row
    return None


def record_attempt(
    directory: Path,
    row: dict,
    correct: bool,
    note: str,
    tags: list[str],
    submitted: str | None = None,
    gap: str | None = None,
) -> dict:
    attempts = read_json(directory, "attempts")
    heat = read_json(directory, "heatmap")
    streaks = read_json(directory, "streaks")
    ticks = read_json(directory, "skill-ticks")
    mocks = read_json(directory, "mocks")
    prev = None
    for item in attempts["items"]:
        if item.get("problem_id") == row["id"]:
            prev = item
    srs = model.next_srs(prev, correct, today())
    item = {
        "ts": now_iso(),
        "problem_id": row["id"],
        "correct": correct,
        "tags": tags,
        "note": note,
        **srs,
    }
    if submitted is not None:
        item["submitted"] = submitted
    if gap:
        item["gap"] = gap
    err = model.attempt_problem(item)
    if err:
        die(err)
    attempts["items"].append(item)
    heat["topics"] = model.bump_heatmap(heat.get("topics") or {}, tags, correct)
    heat_err = model.heatmap_problem(heat["topics"])
    if heat_err:
        die(heat_err)
    touched = model.touch_streak(streaks.get("days") or [], today())
    streaks.update(touched)
    write_json(directory, "attempts", attempts)
    write_json(directory, "heatmap", heat)
    write_json(directory, "streaks", streaks)
    project(directory, ticks, attempts, mocks)
    return item


def nonempty_file(path: Path) -> bool:
    return path.is_file() and path.stat().st_size > 0


def reference_pdf_status() -> str:
    sums = ROOT / "sources" / "sha256sums"
    inventory = ROOT / "past" / "inventory.json"
    try:
        lines = sums.read_text().splitlines()
        artifacts = json.loads(inventory.read_text())["artifacts"]
    except (OSError, json.JSONDecodeError, KeyError, TypeError):
        return "missing"
    if not isinstance(artifacts, list):
        return "missing"
    for line in lines:
        text = line.strip()
        if not text or text.startswith("#"):
            continue
        parts = text.split(None, 1)
        if len(parts) != 2 or not parts[1].endswith(".pdf"):
            continue
        if not nonempty_file(ROOT / "sources" / parts[1]):
            return "missing"
    for art in artifacts:
        if not isinstance(art, dict):
            return "missing"
        if art.get("present") is False:
            continue
        rel = art.get("path")
        if not isinstance(rel, str) or not nonempty_file(ROOT / rel):
            return "missing"
    return "ok"


def cmd_doctor(fmt: str) -> int:
    try:
        import sympy
    except ImportError:
        die("sympy missing. python3 -m pip install sympy")
    yang = ROOT / "sources" / "user" / "Integration_Bee_Topics_Guide_Yang_2nd_Ed.pdf"
    units = sorted(p for p in (ROOT / "units").glob("[0-9][0-9]-*") if p.is_dir())
    drills = load_drills()
    missing_unit = []
    for unit in units:
        n = int(unit.name.split("-", 1)[0])
        if not (ROOT / "verify" / f"drills_unit{n}.json").exists():
            missing_unit.append(unit.name)
    ok = bool(yang.is_file() and units and not missing_unit and drills)
    payload = {
        "ready": ok,
        "root": str(ROOT),
        "sympy": sympy.__version__,
        "units": len(units),
        "drills": len(drills),
        "yang_pdf": "ok" if yang.is_file() else "missing",
        "official_pdfs": reference_pdf_status(),
        "data_dir": str(data_dir(None)),
    }
    if missing_unit:
        payload["missing_units"] = missing_unit
    if fmt == "json":
        emit(payload, fmt)
    else:
        print("READY integration-bee" if ok else "NOT_READY integration-bee")
        for key, value in payload.items():
            print(f"{key}={value}")
    return 0 if ok else 1


def cmd_practice_list(args) -> int:
    rows = []
    for row in load_drills():
        if args.unit and not str(row["unit"]).startswith(f"{args.unit:02d}-"):
            continue
        if args.tag:
            bag = set(row.get("technique_tags") or [])
            bag.add(row.get("technique"))
            bag.update(row.get("yang") or [])
            if not any(tag in bag for tag in args.tag):
                continue
        rows.append(public_drill(row))
    shown = take_limit(rows, args.limit)
    if args.format == "json":
        emit({"drills": shown}, "json")
    else:
        write_table(len(rows), ["id", "unit", "technique", "kind", "latex"], shown)
    return 0


def cmd_practice_next(args) -> int:
    directory = data_dir(args.data_dir)
    items = read_json(directory, "attempts").get("items") or []
    drills = load_drills()
    by_id = {row["id"]: row for row in drills}
    latest = latest_by_id(items)
    today_iso = today().isoformat()
    due = sorted(
        (item["next_due"], pid)
        for pid, item in latest.items()
        if pid in by_id and item.get("next_due") and item["next_due"] <= today_iso
    )
    chosen = None
    reason = "new"
    if due:
        chosen = by_id[due[0][1]]
        reason = "due"
    else:
        ticks = read_json(directory, "skill-ticks")["ticks"]
        session = load_session(read_json(directory, "session"))
        full = session["aptitude"]["full_coverage"] is True
        units: list[str] = []
        for node in catalog():
            if node.get("gate") != "round1":
                continue
            status = (ticks.get(node["id"]) or {}).get("status")
            if model.coach_queue_done(status, full):
                continue
            unit = node.get("unit")
            if unit and unit not in units:
                units.append(unit)
        if not units:
            reason = "queue_clear"
        else:
            for unit in units:
                for row in drills:
                    if row["unit"] != unit:
                        continue
                    last = latest.get(row["id"])
                    if last and last.get("correct") is True:
                        continue
                    chosen = row
                    break
                if chosen is not None:
                    break
            if chosen is None:
                reason = "unit_clear"
    if chosen is None:
        emit({"id": None, "reason": reason}, args.format)
        return 0
    view = public_drill(chosen)
    view["reason"] = reason
    emit(view, args.format)
    return 0


def cmd_practice_check(args) -> int:
    row = find_drill(args.id)
    if row is None:
        die(f"unknown drill {args.id}")
    try:
        correct = turn_contract.answer_matches(row, args.answer)
    except Exception as exc:
        die(f"answer did not parse: {exc}", 2)
    tags = list(row.get("technique_tags") or [])
    note = "final answer matched" if correct else "final answer differed"
    item = record_attempt(data_dir(args.data_dir), row, correct, note, tags)
    emit(
        {
            "id": row["id"],
            "correct": correct,
            "expected_display": row.get("answer_display"),
            "next_due": item["next_due"],
        },
        args.format,
    )
    return 0 if correct else 1


def load_problem_rows() -> list[dict]:
    path = problem_catalog.RECORDS
    if not path.is_file():
        die(f"missing {path.relative_to(ROOT)}")
    try:
        return problem_catalog.load_records(path)
    except (ValueError, json.JSONDecodeError) as exc:
        die(f"catalog did not parse: {exc}")


def problem_spec(args) -> dict:
    spec = {
        "id": getattr(args, "id", None),
        "round": fold_token(getattr(args, "problem_round", None), problem_catalog.ROUNDS),
        "year": getattr(args, "year", None),
        "source": fold_token(getattr(args, "source", None), problem_catalog.SOURCES),
        "verify": fold_token(getattr(args, "verify", None), problem_catalog.VERIFIES),
        "problem_id": getattr(args, "problem_id", None),
    }
    err = problem_catalog.spec_problem(spec)
    if err:
        die(err, 2)
    return spec


def cmd_problems_list(args) -> int:
    spec = problem_spec(args)
    rows = problem_catalog.matching(load_problem_rows(), spec)
    shown = take_limit(rows, args.limit)
    views = [problem_catalog.index_view(row) for row in shown]
    if args.format == "json":
        emit({"count": len(rows), "problems": views}, "json")
    else:
        write_table(
            len(rows),
            ["id", "round", "year", "problem_id", "verify", "kind", "source", "has_answer"],
            views,
        )
    return 0


def cmd_problems_show(args) -> int:
    rows = problem_catalog.matching(load_problem_rows(), {"id": args.id})
    if len(rows) != 1:
        die(f"unknown problem {args.id}")
    emit(rows[0], args.format)
    return 0


def cmd_problems_select(args) -> int:
    spec = problem_spec(args)
    if not any(spec.values()):
        die("select needs a filter", 2)
    rows = problem_catalog.matching(load_problem_rows(), spec)
    if not rows:
        die("unknown problem")
    if len(rows) != 1:
        ids = [str(row.get("id")) for row in rows[:8]]
        extra = f" (+{len(rows) - 8} more)" if len(rows) > 8 else ""
        die(f"select matched {len(rows)} problems: {', '.join(ids)}{extra}. Pass --id.", 2)
    emit(problem_catalog.prompt_view(rows[0]), args.format)
    return 0


def cmd_drills_list(args) -> int:
    rows = []
    for row in load_drills():
        if args.unit and not str(row["unit"]).startswith(f"{args.unit:02d}-"):
            continue
        if args.id and row["id"] != args.id:
            continue
        view = public_drill(row)
        view["answer_display"] = row.get("answer_display")
        rows.append(view)
    shown = take_limit(rows, args.limit)
    if args.format == "json":
        emit({"drills": shown}, "json")
    else:
        write_table(len(rows), ["id", "unit", "technique", "kind", "answer_display"], shown)
    return 0 if rows else 1


def cmd_progress_show(args) -> int:
    directory = data_dir(args.data_dir)
    ticks = read_json(directory, "skill-ticks")
    attempts = read_json(directory, "attempts")
    heat = read_json(directory, "heatmap")
    streaks = read_json(directory, "streaks")
    topics = heat.get("topics") or {}
    weak = sorted(
        ({"tag": tag, **row} for tag, row in topics.items() if row.get("fails", 0) > 0),
        key=lambda row: (-row.get("fails", 0), row["tag"]),
    )
    session = load_session(read_json(directory, "session"))
    full = session["aptitude"]["full_coverage"] is True
    nxt = None
    for node in catalog():
        if node.get("gate") != "round1":
            continue
        status = (ticks["ticks"].get(node["id"]) or {}).get("status")
        if not model.coach_queue_done(status, full):
            nxt = node["id"]
            break
    emit(
        {
            "ticks": ticks["ticks"],
            "attempts": [
                {"problem_id": item.get("problem_id"), "correct": item.get("correct")}
                for item in attempts.get("items") or []
            ],
            "due": model.due_ids(attempts.get("items") or [], today()),
            "streak": {"current": streaks.get("current", 0), "best": streaks.get("best", 0)},
            "weak": weak,
            "next_node": nxt,
        },
        args.format,
    )
    return 0


def cmd_tick(args) -> int:
    directory = data_dir(args.data_dir)
    ids = {node["id"] for node in catalog()}
    ticks = read_json(directory, "skill-ticks")
    ticks["ticks"][args.node] = {"status": args.status, "ts": now_iso()}
    err = model.tick_problem(ticks["ticks"], ids)
    if err:
        die(err)
    write_json(directory, "skill-ticks", ticks)
    project(directory, ticks, read_json(directory, "attempts"), read_json(directory, "mocks"))
    emit({"node": args.node, "status": args.status}, args.format)
    return 0


def cmd_mistake(args) -> int:
    row = find_drill(args.id) or {"id": args.id, "technique_tags": args.tag}
    record_attempt(data_dir(args.data_dir), row, False, args.note, args.tag)
    emit({"id": args.id, "recorded": True}, args.format)
    return 0


def cmd_mock_start(args) -> int:
    directory = data_dir(args.data_dir)
    ticks = read_json(directory, "skill-ticks")
    reason = model.mock_block_reason(
        ticks["ticks"],
        [node["id"] for node in catalog() if node.get("gate") == "round1"],
        args.cold,
    )
    if reason:
        die(reason, 2)
    mocks = read_json(directory, "mocks")
    for session in mocks["sessions"]:
        if session.get("score") is None:
            emit(session, args.format)
            return 0
    session = {
        "id": args.id or now_iso(),
        "started": now_iso(),
        "ended": None,
        "score": None,
        "out_of": args.out_of,
        "missed": [],
        "cold": bool(args.cold),
    }
    err = model.mock_session_problem(session)
    if err:
        die(err)
    mocks["sessions"].append(session)
    write_json(directory, "mocks", mocks)
    project(directory, ticks, read_json(directory, "attempts"), mocks)
    emit(session, args.format)
    return 0


def cmd_mock_finish(args) -> int:
    directory = data_dir(args.data_dir)
    learner = load_session(read_json(directory, "session"))
    phase = learner.get("phase")
    if phase in {"awaiting_answer", "aptitude"}:
        die("an integral is still open", 2)
    if phase == "proposing":
        die("confirm the skip offer first", 2)
    mocks = read_json(directory, "mocks")
    found = None
    for session in mocks["sessions"]:
        if session.get("id") == args.id:
            found = session
            break
    if found is None:
        die(f"unknown mock {args.id}")
    found["score"] = args.score
    found["out_of"] = args.out_of
    found["ended"] = now_iso()
    found["missed"] = args.missed
    err = model.mock_session_problem(found)
    if err:
        die(err)
    write_json(directory, "mocks", mocks)
    project(directory, read_json(directory, "skill-ticks"), read_json(directory, "attempts"), mocks)
    emit(found, args.format)
    return 0


def cmd_journal(args) -> int:
    directory = data_dir(args.data_dir)
    journal = read_json(directory, "journal")
    note = {"ts": now_iso(), "technique": args.technique, "note": args.note}
    err = model.journal_problem(note)
    if err:
        die(err)
    journal["notes"].append(note)
    streaks = read_json(directory, "streaks")
    streaks.update(model.touch_streak(streaks.get("days") or [], today()))
    write_json(directory, "journal", journal)
    write_json(directory, "streaks", streaks)
    emit(note, args.format)
    return 0


def cmd_streak(args) -> int:
    directory = data_dir(args.data_dir)
    streaks = read_json(directory, "streaks")
    streaks.update(model.touch_streak(streaks.get("days") or [], today()))
    write_json(directory, "streaks", streaks)
    emit(streaks, args.format)
    return 0


def cmd_verify() -> int:
    proc = subprocess.run(["bash", str(ROOT / "verify" / "run.sh")], cwd=ROOT)
    return proc.returncode


def load_feed() -> list[dict]:
    return json.loads((ROOT / "past" / "samples" / "answers_feed.json").read_text())


def turn_sources() -> tuple[list[dict], list[dict]]:
    mock_text = (ROOT / "past" / "mocks" / "mock01-meta.yaml").read_text()
    paper_text = (ROOT / "past" / "mocks" / "mock-pdf-round1.yaml").read_text()
    return turn_contract.parse_mock01(mock_text), turn_contract.parse_papers(paper_text)


def session_view(session: dict) -> dict:
    return {
        "phase": session.get("phase"),
        "node": session.get("node"),
        "problem_id": session.get("problem_id"),
        "mock_id": session.get("mock_id"),
        "updated": session.get("updated"),
    }


def turn_payload(directory: Path, session: dict, say: str, drill, mark, mock, problems, tick, result_ticks=None) -> dict:
    ticks = read_json(directory, "skill-ticks")
    heat = read_json(directory, "heatmap")
    return {
        "ok": True,
        "session": session_view(session),
        "coach": turn_contract.coach_view(catalog(), ticks["ticks"], heat, load_drills(), session),
        "say": say,
        "drill": drill,
        "mark": mark,
        "mock": mock,
        "problems": problems,
        "tick": tick,
        "ticks": [] if result_ticks is None else result_ticks,
    }


def write_session(directory: Path, session: dict) -> None:
    err = model.session_problem(session)
    if err:
        die(err)
    write_json(directory, "session", session)
    project(
        directory,
        read_json(directory, "skill-ticks"),
        read_json(directory, "attempts"),
        read_json(directory, "mocks"),
        session,
    )


def apply_tick(directory: Path, tick: dict | None) -> None:
    if not tick:
        return
    ids = {node["id"] for node in catalog()}
    ticks = read_json(directory, "skill-ticks")
    ticks["ticks"][tick["node"]] = {"status": tick["status"], "ts": now_iso()}
    err = model.tick_problem(ticks["ticks"], ids)
    if err:
        die(err)
    write_json(directory, "skill-ticks", ticks)


def apply_ledger(directory: Path, ledger: dict | None) -> None:
    if not ledger:
        return
    doc = read_json(directory, "marks")
    doc["marks"] = model.put_mark(
        doc.get("marks") or {},
        ledger["id"],
        answer_ok=ledger["answer_ok"],
        method_ok=ledger["method_ok"],
        technique=ledger["technique"],
        note=ledger.get("note") or "",
    )
    err = model.mark_problem(doc["marks"])
    if err:
        die(err)
    write_json(directory, "marks", doc)


def apply_sticky(directory: Path, sticky: dict | None) -> None:
    if not sticky:
        return
    doc = read_json(directory, "stickies")
    doc["cards"] = model.put_sticky(
        doc.get("cards") or {},
        sticky["technique"],
        sticky["note"],
        today(),
    )
    err = model.sticky_problem(doc["cards"])
    if err:
        die(err)
    write_json(directory, "stickies", doc)


def apply_journal(directory: Path, journal: dict | None) -> None:
    if not journal:
        return
    notes = read_json(directory, "journal")
    note = {"ts": now_iso(), "technique": journal["technique"], "note": journal["note"]}
    err = model.journal_problem(note)
    if err:
        die(err)
    notes["notes"].append(note)
    streaks = read_json(directory, "streaks")
    streaks.update(model.touch_streak(streaks.get("days") or [], today()))
    write_json(directory, "journal", notes)
    write_json(directory, "streaks", streaks)


def read_turn(path: str) -> dict:
    if path == "-":
        raw = sys.stdin.read()
    else:
        file = Path(path)
        if not file.is_file():
            die(f"turn file not found: {path}", 2)
        try:
            raw = file.read_text()
        except OSError as exc:
            die(f"turn file unreadable: {exc}", 2)
    try:
        body = json.loads(raw)
    except json.JSONDecodeError as exc:
        die(f"turn json did not parse: {exc}", 2)
    if not isinstance(body, dict) or not body.get("kind"):
        die("turn needs kind", 2)
    return body


def fill_gap(directory: Path, problem_id: str, gap: str) -> None:
    attempts = read_json(directory, "attempts")
    found = None
    for item in attempts["items"]:
        if item.get("problem_id") == problem_id:
            found = item
    if found is None:
        die("gap fill has no attempt", 2)
    found["gap"] = gap
    err = model.attempt_problem(found)
    if err:
        die(err, 2)
    write_json(directory, "attempts", attempts)


def finish_plan(directory: Path, plan: dict, fmt: str) -> int:
    effects = plan.get("effects") or {}
    attempt = effects.get("attempt")
    gap_fill = effects.get("gap_fill")
    if attempt and gap_fill:
        die("attempt and gap_fill are both set", 2)
    if plan["exit"] == 2:
        die(plan["error"] or "turn refused", 2)
    if attempt:
        drills = load_drills()
        row = turn_contract.find_drill(drills, attempt["problem_id"]) or {"id": attempt["problem_id"]}
        record_attempt(
            directory,
            row,
            attempt["correct"],
            attempt["note"],
            attempt["tags"],
            attempt.get("submitted"),
            attempt.get("gap"),
        )
    if gap_fill:
        fill_gap(directory, gap_fill["problem_id"], gap_fill["gap"])
    apply_journal(directory, plan.get("journal"))
    apply_ledger(directory, plan.get("ledger"))
    apply_sticky(directory, plan.get("sticky"))
    listed = plan.get("ticks")
    if isinstance(listed, list) and listed:
        for item in listed:
            apply_tick(directory, item)
    elif plan.get("tick"):
        apply_tick(directory, plan["tick"])
    write_session(directory, plan["session"])
    shown_ticks = [] if plan.get("tick") else list(plan.get("ticks") or [])
    payload = turn_payload(
        directory,
        plan["session"],
        plan.get("say") or "",
        plan.get("drill"),
        plan.get("mark"),
        None,
        plan.get("problems"),
        plan.get("tick"),
        shown_ticks,
    )
    emit(payload, fmt)
    return plan["exit"]


def cmd_turn_schema(fmt: str) -> int:
    folder = ROOT / "contracts"
    payload = {
        "request": json.loads((folder / "turn-request.schema.json").read_text()),
        "result": json.loads((folder / "turn-result.schema.json").read_text()),
    }
    emit(payload, fmt)
    return 0


def cmd_turn_show(args) -> int:
    directory = data_dir(args.data_dir)
    session = load_session(read_json(directory, "session"))
    emit(
        turn_payload(directory, session, "The session is unchanged.", None, None, None, None, None),
        args.format,
    )
    return 0


def start_mock_record(directory: Path, body: dict, pack: str, out_of: int, year) -> dict:
    ticks = read_json(directory, "skill-ticks")
    reason = model.mock_block_reason(
        ticks["ticks"],
        [node["id"] for node in catalog() if node.get("gate") == "round1"],
        bool(body.get("cold")),
    )
    if reason:
        die(reason, 2)
    mocks = read_json(directory, "mocks")
    session = {
        "id": body.get("id") or now_iso(),
        "started": now_iso(),
        "ended": None,
        "score": None,
        "out_of": out_of,
        "missed": [],
        "cold": bool(body.get("cold")),
        "pack": pack,
        "year": year,
    }
    err = model.mock_session_problem(session)
    if err:
        die(err)
    mocks["sessions"].append(session)
    write_json(directory, "mocks", mocks)
    project(directory, ticks, read_json(directory, "attempts"), mocks)
    return session


def describe_pack(pack: str, year, out_of_request) -> tuple[int, int, list, object]:
    mock01, papers = turn_sources()
    if pack == "mock01":
        out_of = int(out_of_request or len(mock01) or 30)
        problems = [{"id": row["id"], "source": row.get("source")} for row in mock01]
        return out_of, 120, problems, None
    if pack == "pdf-round1":
        views = turn_contract.paper_on_disk(papers, lambda rel: (ROOT / rel).is_file())
        chosen = next((row for row in views if year and row["year"] == int(year)), None)
        if chosen is None:
            chosen = views[0]
        out_of = int(out_of_request or chosen["count"])
        return out_of, chosen["duration_minutes"], [chosen], chosen["year"]
    die(f"unknown pack {pack}", 2)


def pack_request_differs(body: dict, mock: dict) -> bool:
    pack = mock.get("pack") or "mock01"
    requested = body.get("pack") or "mock01"
    if requested != pack:
        return True
    if body.get("id") and body["id"] != mock.get("id"):
        return True
    if requested == "pdf-round1" and body.get("year") not in (None, "") and str(body.get("year")) != str(mock.get("year")):
        return True
    return False


def unscored_mock(directory: Path) -> dict | None:
    for row in read_json(directory, "mocks").get("sessions") or []:
        if row.get("score") is None:
            return row
    return None


def mock_message(mock: dict, duration: int, problems: list, mode: str) -> str:
    pack = mock.get("pack") or "mock01"
    on_disk = True
    if pack == "pdf-round1":
        on_disk = bool(problems and isinstance(problems[0], dict) and problems[0].get("on_disk"))
    if pack == "pdf-round1" and not on_disk:
        return "The problems PDF is not on disk. Say so. Do not invent the paper. Mark a concept drill instead."
    clock = f"{duration} minutes from {mock['started']}."
    if mode == "stay":
        return (
            f"The open mock stays {mock['id']} ({pack}). "
            f"Finish it before starting another pack. {clock} "
            "Serve each problem in words. Keep file paths to yourself."
        )
    if mode == "continue":
        return (
            f"A timed mock is still open ({mock['id']}, {pack}). {clock} "
            "Serve the next problem in words. Keep file paths to yourself. "
            "Do not start a new concept."
        )
    return (
        f"A timed mock is open. {clock} "
        "Serve each problem in words. Keep file paths to yourself."
    )


def mock_view(mock: dict, mode: str) -> tuple[str, int, list]:
    pack = mock.get("pack") or "mock01"
    _, duration, problems, _ = describe_pack(pack, mock.get("year"), mock.get("out_of"))
    return mock_message(mock, duration, problems, mode), duration, problems


def cmd_turn_mock_start(args, body: dict) -> int:
    directory = data_dir(args.data_dir)
    learner = load_session(read_json(directory, "session"))
    if learner.get("phase") in {"awaiting_answer", "aptitude"}:
        die("an integral is still open", 2)
    if learner.get("phase") == "proposing":
        die("confirm the skip offer first", 2)
    open_mock = unscored_mock(directory)
    if open_mock is not None:
        mode = "stay" if pack_request_differs(body, open_mock) else "open"
        say, duration, problems = mock_view(open_mock, mode)
        mock = open_mock
    else:
        pack = body.get("pack") or "mock01"
        out_of, duration, problems, year = describe_pack(pack, body.get("year"), body.get("out_of"))
        mock = start_mock_record(directory, body, pack, out_of, year)
        say = mock_message(mock, duration, problems, "open")
    phase = "mock_awaiting" if learner.get("phase") == "mock_awaiting" else "mock_open"
    problem_id = learner.get("problem_id") if phase == "mock_awaiting" else None
    node = learner.get("node") if phase == "mock_awaiting" else None
    try:
        updated = turn_contract._set_phase(learner, phase, node, problem_id, mock["id"], now_iso())
    except ValueError as exc:
        die(str(exc))
    write_session(directory, updated)
    payload = turn_payload(directory, updated, say, None, None, mock, problems, None)
    payload["duration_minutes"] = duration
    emit(payload, args.format)
    return 0


def cmd_turn_mock_finish(args, body: dict) -> int:
    directory = data_dir(args.data_dir)
    learner = load_session(read_json(directory, "session"))
    if body.get("score") is None or not body.get("id"):
        die("mock-finish needs id and score", 2)
    phase = learner.get("phase")
    if phase in {"awaiting_answer", "aptitude"}:
        die("an integral is still open", 2)
    if phase == "proposing":
        die("confirm the skip offer first", 2)
    if phase in {"mock_open", "mock_awaiting"} and learner.get("mock_id") not in (None, body["id"]):
        die(f"open mock is {learner.get('mock_id')}", 2)
    mocks = read_json(directory, "mocks")
    found = None
    for session in mocks["sessions"]:
        if session.get("id") == body["id"]:
            found = session
            break
    if found is None:
        die(f"unknown mock {body['id']}")
    found["score"] = body["score"]
    found["out_of"] = int(body.get("out_of") or found.get("out_of") or 30)
    found["ended"] = now_iso()
    found["missed"] = list(body.get("missed") or [])
    err = model.mock_session_problem(found)
    if err:
        die(err)
    write_json(directory, "mocks", mocks)
    try:
        closed = turn_contract._set_phase(learner, "idle", None, None, None, now_iso())
    except ValueError as exc:
        die(str(exc))
    write_session(directory, closed)
    payload = turn_payload(
        directory,
        closed,
        "The mock is stored. Teach the misses in the missed list.",
        None,
        None,
        found,
        None,
        None,
    )
    emit(payload, args.format)
    return 0


def cmd_turn_apply(args) -> int:
    body = read_turn(args.file)
    kind = body["kind"]
    directory = data_dir(args.data_dir)
    session = load_session(read_json(directory, "session"))
    attempts = read_json(directory, "attempts").get("items") or []
    ticks = read_json(directory, "skill-ticks")["ticks"]
    heat = read_json(directory, "heatmap")
    drills = load_drills()
    cat = catalog()
    updated = now_iso()
    if kind == "empty":
        drill = None
        problems = None
        phase = session.get("phase")
        if phase == "aptitude" and session.get("problem_id"):
            drill, problems, say = turn_contract.describe_open_probe(session, drills, load_problem_rows())
        elif phase == "proposing":
            ids = ", ".join(session["aptitude"]["offer"])
            say = (
                f"These nodes can be skipped: {ids}. "
                "Nothing is skipped until a confirm turn repeats the ids."
            )
        elif phase == "mock_open":
            mock = unscored_mock(directory)
            if mock is None or mock.get("id") != session.get("mock_id"):
                say = "The session says a mock is open, but no unscored mock is stored."
                emit(turn_payload(directory, session, say, None, None, None, None, None), args.format)
                return 0
            say, duration, problems = mock_view(mock, "continue")
            payload = turn_payload(directory, session, say, None, None, mock, problems, None)
            payload["duration_minutes"] = duration
            emit(payload, args.format)
            return 0
        elif phase in {"awaiting_answer", "mock_awaiting"} and session.get("problem_id"):
            row = turn_contract.find_drill(drills, session["problem_id"])
            drill = turn_contract.drill_public(row) if row else None
            say = "An integral is still open. Show it again. Do not show an answer."
        else:
            say = "Ask whether they want a new concept or to mark work they already did."
            node = turn_contract.recommend_node(
                cat,
                ticks,
                heat,
                drills,
                full_coverage=session["aptitude"]["full_coverage"] is True,
            )
            if node:
                say = f"{say} The next node is {node['id']}."
        emit(turn_payload(directory, session, say, drill, None, None, problems, None), args.format)
        return 0
    if kind == "teach":
        plan = turn_contract.plan_teach(
            session, attempts, ticks, cat, drills, heat, updated, load_problem_rows()
        )
        return finish_plan(directory, plan, args.format)
    if kind == "mark":
        plan = turn_contract.plan_mark(
            session,
            attempts,
            ticks,
            cat,
            drills,
            load_feed(),
            body,
            updated,
            load_problem_rows(),
        )
        return finish_plan(directory, plan, args.format)
    if kind == "aptitude":
        plan = turn_contract.plan_aptitude(
            session, attempts, ticks, cat, drills, load_problem_rows(), updated
        )
        return finish_plan(directory, plan, args.format)
    if kind == "confirm":
        plan = turn_contract.plan_confirm(session, ticks, cat, body, updated)
        return finish_plan(directory, plan, args.format)
    if kind == "cover":
        plan = turn_contract.plan_cover(session, cat, drills, body, updated)
        return finish_plan(directory, plan, args.format)
    if kind == "mock-start":
        return cmd_turn_mock_start(args, body)
    if kind == "mock-finish":
        return cmd_turn_mock_finish(args, body)
    die(f"unknown turn kind {kind}", 2)


def build_parser() -> argparse.ArgumentParser:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--data-dir",
        default=argparse.SUPPRESS,
        help="Tracker directory. Overrides IB_DATA_DIR. doctor ignores this flag.",
    )
    shared.add_argument(
        "--format",
        choices=("text", "json"),
        default=argparse.SUPPRESS,
        help="json is the stable record. text is a table for list commands.",
    )
    command_lines = ["Commands:"]
    for row in COMMANDS:
        command_lines.append(f"  {row['path']}")
        command_lines.append(f"    {row['summary']}")
    parser = argparse.ArgumentParser(
        prog="control-integration-bee",
        description="Companion CLI for Integration Bee. The learner does not run this program.",
        epilog="\n".join(
            [
                "Recorded results use --format json.",
                "problems list, practice list, and drills list print a table when the format is text.",
                "Set IB_DATA_DIR or pass --data-dir so two runs do not share tracker files.",
                "doctor reports IB_DATA_DIR and ignores --data-dir.",
                "",
                *command_lines,
            ]
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--commands-json", action="store_true", help="Print the command list as JSON and exit.")
    parser.add_argument(
        "--data-dir",
        default=None,
        help="Tracker directory. Overrides IB_DATA_DIR. doctor ignores this flag.",
    )
    parser.add_argument(
        "--format",
        choices=("text", "json"),
        default="text",
        help="json is the stable record. text is a table for list commands.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    def leaf(parent, name: str, path: str):
        text = HELP[path]
        return parent.add_parser(name, parents=[shared], help=text, description=text)

    def group(parent, name: str, text: str):
        return parent.add_parser(name, parents=[shared], help=text, description=text)

    leaf(sub, "doctor", "doctor")
    leaf(sub, "verify", "verify")
    practice = group(sub, "practice", "Serve a drill and record a SymPy check.")
    psub = practice.add_subparsers(dest="practice_cmd", required=True)
    plist = leaf(psub, "list", "practice list")
    plist.add_argument("--tag", action="append", default=[], help="Keep a drill when this tag matches. Repeat for more.")
    plist.add_argument("--unit", type=int, help="Unit number. 1 matches a unit whose name starts with 01-.")
    plist.add_argument("--limit", type=int, default=0, help="Stop after this many rows. 0 lists every match.")
    leaf(psub, "next", "practice next")
    pcheck = leaf(psub, "check", "practice check")
    pcheck.add_argument("--id", required=True, help="Drill id.")
    pcheck.add_argument("--answer", required=True, help="SymPy expression. An indefinite answer may include +C.")
    progress = group(sub, "progress", "Read and write ticks, misses, mocks, notes, and the streak.")
    g = progress.add_subparsers(dest="progress_cmd", required=True)
    leaf(g, "show", "progress show")
    tick = leaf(g, "tick", "progress tick")
    tick.add_argument("--node", required=True, help="Skill-tree node id.")
    tick.add_argument("--status", required=True, choices=("learning", "solid", "skipped"), help="learning, solid, or skipped.")
    mistake = leaf(g, "mistake", "progress mistake")
    mistake.add_argument("--id", required=True, help="Drill or problem id.")
    mistake.add_argument("--tag", action="append", required=True, help="Topic tag. Repeat for more.")
    mistake.add_argument("--note", required=True, help="What went wrong.")
    mock_start = leaf(g, "mock-start", "progress mock-start")
    mock_start.add_argument("--id", default=None, help="Mock id. Defaults to the current time.")
    mock_start.add_argument("--cold", action="store_true", help="Open a mock before Round 1 nodes are solid.")
    mock_start.add_argument("--out-of", type=int, default=30, help="Number of problems.")
    mock_finish = leaf(g, "mock-finish", "progress mock-finish")
    mock_finish.add_argument("--id", required=True, help="Mock id.")
    mock_finish.add_argument("--score", type=int, required=True, help="Problems scored correct.")
    mock_finish.add_argument("--out-of", type=int, default=30, help="Problems on the paper.")
    mock_finish.add_argument("--missed", action="append", default=[], help="Missed problem id. Repeat for more.")
    journal = leaf(g, "journal", "progress journal")
    journal.add_argument("--technique", required=True, help="Technique name.")
    journal.add_argument("--note", required=True, help="Technique note.")
    leaf(g, "streak", "progress streak")
    drills = group(sub, "drills", "List drill ids and display answers.")
    dsub = drills.add_subparsers(dest="drills_cmd", required=True)
    dlist = leaf(dsub, "list", "drills list")
    dlist.add_argument("--unit", type=int, help="Unit number. 1 matches a unit whose name starts with 01-.")
    dlist.add_argument("--id", help="One drill id.")
    dlist.add_argument("--limit", type=int, default=0, help="Stop after this many rows. 0 lists every match.")
    problems = group(sub, "problems", "Read the contest and Yang catalog.")
    bsub = problems.add_subparsers(dest="problems_cmd", required=True)

    def add_problem_filters(target: argparse.ArgumentParser, require_id: bool = False, with_limit: bool = False) -> None:
        target.add_argument("--round", dest="problem_round", help="r1, r2, r3, or yang. Case does not matter.")
        target.add_argument("--year", help="Contest year.")
        target.add_argument("--source", help="resource_pack or yang_book. Case does not matter.")
        target.add_argument("--verify", help="manual, unchecked, or sympy. Case does not matter.")
        target.add_argument("--id", required=require_id, help="Catalog id.")
        target.add_argument("--problem-id", dest="problem_id", help="Id printed on the paper.")
        if with_limit:
            target.add_argument("--limit", type=int, default=0, help="Stop after this many rows. 0 lists every match. count stays the match total.")

    add_problem_filters(leaf(bsub, "list", "problems list"), with_limit=True)
    add_problem_filters(leaf(bsub, "show", "problems show"), require_id=True)
    add_problem_filters(leaf(bsub, "select", "problems select"))
    turn = group(sub, "turn", "Apply one companion turn.")
    tsub = turn.add_subparsers(dest="turn_cmd", required=True)
    leaf(tsub, "schema", "turn schema")
    leaf(tsub, "show", "turn show")
    tapply = leaf(tsub, "apply", "turn apply")
    tapply.add_argument("--file", required=True, help="Turn JSON file. Use - to read stdin.")
    return parser


def main() -> int:
    if "--commands-json" in sys.argv:
        print(json.dumps(COMMANDS, indent=2))
        return 0
    parser = build_parser()
    args = parser.parse_args()
    if args.cmd == "doctor":
        return cmd_doctor(args.format)
    if args.cmd == "verify":
        return cmd_verify()
    if args.cmd == "practice" and args.practice_cmd == "list":
        return cmd_practice_list(args)
    if args.cmd == "practice" and args.practice_cmd == "next":
        return cmd_practice_next(args)
    if args.cmd == "practice" and args.practice_cmd == "check":
        return cmd_practice_check(args)
    if args.cmd == "drills" and args.drills_cmd == "list":
        return cmd_drills_list(args)
    if args.cmd == "problems" and args.problems_cmd == "list":
        return cmd_problems_list(args)
    if args.cmd == "problems" and args.problems_cmd == "show":
        return cmd_problems_show(args)
    if args.cmd == "problems" and args.problems_cmd == "select":
        return cmd_problems_select(args)
    if args.cmd == "turn" and args.turn_cmd == "schema":
        return cmd_turn_schema(args.format)
    if args.cmd == "turn" and args.turn_cmd == "show":
        return cmd_turn_show(args)
    if args.cmd == "turn" and args.turn_cmd == "apply":
        return cmd_turn_apply(args)
    if args.cmd == "progress" and args.progress_cmd == "show":
        return cmd_progress_show(args)
    if args.cmd == "progress" and args.progress_cmd == "tick":
        return cmd_tick(args)
    if args.cmd == "progress" and args.progress_cmd == "mistake":
        return cmd_mistake(args)
    if args.cmd == "progress" and args.progress_cmd == "mock-start":
        return cmd_mock_start(args)
    if args.cmd == "progress" and args.progress_cmd == "mock-finish":
        return cmd_mock_finish(args)
    if args.cmd == "progress" and args.progress_cmd == "journal":
        return cmd_journal(args)
    if args.cmd == "progress" and args.progress_cmd == "streak":
        return cmd_streak(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
